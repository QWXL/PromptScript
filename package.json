{
  "name": "promptscript",
  "version": "0.1.2",
  "description": "Line-structure template language for AI prompts",
  "keywords": [
    "ai",
    "llm",
    "prompt",
    "prompt-engineering",
    "prompt-template",
    "template",
    "template-language",
    "templating",
    "language",
    "dsl",
    "cli"
  ],
  "license": "apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "repository": "https://github.com/QWXL/PromptScript",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "promptscript": "./dist/bin/promptscript.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
